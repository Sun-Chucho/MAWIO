{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "ignorePatterns": [
    ".next/**",
    "node_modules/**",
    "recovery-backups/**",
    "public/sw.js"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-require-imports": "off",
    "@typescript-eslint/triple-slash-reference": "off",
    "react/no-unescaped-entities": "off"
  }
}
